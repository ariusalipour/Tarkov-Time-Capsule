BIND_ADDRESS=127.0.0.1
HTTP_PORT=3040
# Enable after checking the archive and confirming this is the sole collector.
SCHEDULER_ENABLED=false

# Optional Discord services (interaction service uses profile discord).
DISCORD_HTTP_PORT=3042
# Keep disabled/dry-run in staging. Server managers configure /updates enable.
DISCORD_UPDATES_ENABLED=false
DISCORD_UPDATES_DRY_RUN=true
